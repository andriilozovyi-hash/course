  },
  {
    "Text": "\u041D\u0430\u0443\u043A\u0430 \u2014 \u0446\u0435 \u043E\u0440\u0433\u0430\u043D\u0456\u0437\u043E\u0432\u0430\u043D\u0435 \u0437\u043D\u0430\u043D\u043D\u044F.",
    "Author": "\u0413\u0435\u0440\u0431\u0435\u0440\u0442 \u0421\u043F\u0435\u043D\u0441\u0435\u0440",
