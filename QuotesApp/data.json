    "Year": 1637
  },
  {
    "Text": "\u0425\u043E\u0447\u0435\u0448 \u0457\u0441\u0442\u0438 \u043A\u0430\u043B\u0430\u0447\u0456 \u043D\u0435 \u0441\u0438\u0434\u0438 \u043D\u0430 \u043F\u0435\u0447\u0456",
